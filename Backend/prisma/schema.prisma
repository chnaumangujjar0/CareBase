generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Appointment {
  id              String   @id @default(uuid()) @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  scheduledAt     DateTime @db.Timestamptz(6)
  durationMinutes Int      @default(30)
  status          String   @default("booked")
  notes           String?
  version         Int      @default(1)

  // Foreign Keys
  tenantId        String   @db.Uuid
  departmentId    String   @db.Uuid
  doctorId        String   @db.Uuid
  patientId       String   @db.Uuid
  createdBy       String?  @db.Uuid
  updatedBy       String?  @db.Uuid

  // Relations
  Tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "appointment_tenantId_fkey")
  Department      Department    @relation(fields: [departmentId], references: [id], onUpdate: NoAction, map: "appointment_departmentId_fkey")
  DoctorProfile   DoctorProfile @relation(fields: [doctorId], references: [id], onUpdate: NoAction, map: "appointment_doctorId_fkey")
  Patient         Patient       @relation(fields: [patientId], references: [id], onUpdate: NoAction, map: "appointment_patientId_fkey")
  Creator         User?         @relation("AppointmentCreator", fields: [createdBy], references: [id], onUpdate: NoAction, map: "appointment_createdBy_fkey")
  Updater         User?         @relation("AppointmentUpdater", fields: [updatedBy], references: [id], onUpdate: NoAction, map: "appointment_updatedBy_fkey")
  Encounter       Encounter?

  @@unique([id, tenantId])
  @@index([createdBy], map: "Appointment_createdBy_idx_ba0f792f")
  @@index([departmentId], map: "Appointment_departmentId_idx_8e261ed8")
  @@index([doctorId], map: "Appointment_doctorId_idx_04369053")
  @@index([patientId], map: "Appointment_patientId_idx_e5f07e88")
  @@index([tenantId], map: "Appointment_tenantId_idx_c93ed4f1")
  @@index([tenantId, scheduledAt], map: "Appointment_tenantId_scheduledAt_idx_31e2839e")
  @@index([updatedBy], map: "Appointment_updatedBy_idx_0780dcde")
  @@index([doctorId, scheduledAt], map: "appointment_doctor_schedule_idx_23b246b0")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  action     String
  entityType String
  entityId   String?  @db.Uuid
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  
  tenantId   String?  @db.Uuid
  userId     String?  @db.Uuid

  Tenant     Tenant?  @relation(fields: [tenantId], references: [id], onUpdate: NoAction, map: "auditLog_tenantId_fkey")
  User       User?    @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "auditLog_userId_fkey")

  @@index([entityType, entityId], map: "AuditLog_entityType_entityId_idx_ea0fa809")
  @@index([tenantId, createdAt], map: "AuditLog_tenantId_createdAt_idx_88162366")
  @@index([tenantId], map: "AuditLog_tenantId_idx_c93ed4f1")
  @@index([userId], map: "AuditLog_userId_idx_a489d58a")
}

model Bed {
  id               String   @id @default(uuid()) @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  code             String
  status           String   @default("available")
  version          Int      @default(1)

  roomId           String   @db.Uuid
  tenantId         String   @db.Uuid
  currentPatientId String?  @db.Uuid

  Room             Room     @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bed_roomId_fkey")
  Tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bed_tenantId_fkey")
  Patient          Patient? @relation(fields: [currentPatientId, tenantId], references: [id, tenantId], onUpdate: NoAction, map: "bed_currentPatientId_fkey")
  BedAssignment    BedAssignment[]

  @@unique([roomId, code], map: "bed_room_code_key_aff24a4e")
  @@unique([id, tenantId])
  @@index([currentPatientId], map: "Bed_currentPatientId_idx_41689716")
  @@index([roomId], map: "Bed_roomId_idx_fe51d647")
  @@index([tenantId], map: "Bed_tenantId_idx_c93ed4f1")
}

model Department {
  id            String          @id @default(uuid()) @db.Uuid
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  name          String
  isActive      Boolean         @default(true)
  
  tenantId      String          @db.Uuid
  Tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "department_tenantId_fkey")
  
  Appointment   Appointment[]
  Encounter     Encounter[]
  Admission     Admission[]
  DoctorProfile DoctorProfile[]
  StaffProfile  StaffProfile[]
  Ward          Ward[]

  @@unique([tenantId, name], map: "department_tenant_name_key_efdfefee")
  @@unique([id, tenantId])
  @@index([tenantId], map: "Department_tenantId_idx_c93ed4f1")
}

model DoctorProfile {
  id                 String               @id @default(uuid()) @db.Uuid
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  isActive           Boolean              @default(true)
  employeeId         String
  designation        String?
  specialization     String
  qualifications     String?
  licenseNumber      String?
  description        String?
  phone              String               @unique

  userId             String               @unique @db.Uuid
  tenantId           String               @db.Uuid
  departmentId       String               @db.Uuid

  User               User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "doctorProfile_userId_fkey")
  Tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "doctorProfile_tenantId_fkey")
  Department         Department           @relation(fields: [departmentId], references: [id], onUpdate: NoAction, map: "doctorProfile_departmentId_fkey")
  
  Appointment        Appointment[]
  Encounter          Encounter[]
  Consultation       Consultation[]
  Prescriptions      Prescription[]
  Admissions         Admission[]
  Surgeries          SurgeryCase[]
  DischargeSummaries DischargeSummary[]
  DoctorAvailability DoctorAvailability[]

  @@unique([id, tenantId], map: "doctorProfile_id_tenantId_key")
  @@index([departmentId], map: "DoctorProfile_departmentId_idx_8e261ed8")
  @@index([tenantId], map: "DoctorProfile_tenantId_idx_c93ed4f1")
}

model DoctorAvailability {
  id            String        @id @default(uuid()) @db.Uuid
  dayOfWeek     Int           // 0 = Sunday ... 6 = Saturday
  startMinute   Int           // Minutes after midnight
  endMinute     Int           // Exclusive end, at most 1440
  isActive      Boolean       @default(true)

  doctorId      String        @db.Uuid
  tenantId      String        @db.Uuid

  DoctorProfile DoctorProfile @relation(fields: [doctorId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction, map: "doctorAvailability_doctorId_fkey")
  Tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "doctorAvailability_tenantId_fkey")

  @@index([tenantId, doctorId, dayOfWeek, isActive], map: "doctorAvailability_schedule_idx")
  @@index([doctorId], map: "doctorAvailability_doctorId_idx")
}

model Patient {
  id                   String        @id @default(uuid()) @db.Uuid
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?     @db.Timestamptz(6)
  isActive             Boolean       @default(true)
  
  mrn                  String
  firstName            String
  lastName             String
  dob                  DateTime      @db.Timestamptz(6)
  gender               String?
  address              String?
  contactEmail         String?
  contactPhone         String?
  emergencyContactName String?
  emergencyContactPhone String?
  insuranceProvider    String?
  insurancePolicyNumber String?
  type                 String        @default("Unknown")

  tenantId             String        @db.Uuid
  Tenant               Tenant        @relation(fields: [tenantId], references: [id], onUpdate: NoAction, map: "patient_tenantId_fkey")

  Appointment          Appointment[]
  Encounter            Encounter[]
  Bed                  Bed[]
  MedicalData          PatientMedicalData[]

  @@unique([tenantId, mrn], map: "patient_tenant_mrn_key_0c21d836")
  @@unique([id, tenantId], map: "patient_id_tenantId_key")
  @@index([tenantId], map: "Patient_tenantId_idx_c93ed4f1")
  @@index([tenantId, lastName], map: "Patient_tenantId_lastName_idx_8d5f431c")
}

model PatientMedicalData {
  id                     String   @id @default(uuid()) @db.Uuid
  recordedAt             DateTime @default(now()) @db.Timestamptz(6)
  heartRate              Int?
  totalCholesterol       Int?
  hemoglobin             Float?
  systolicBloodPressure  Int?
  diastolicBloodPressure Int?
  bloodGlucose           Int?
  whiteBloodCellCount    Int?
  bodyMassIndex          Float?
  respiratoryRate        Int?
  plateletCount          Int?
  allergies              String?
  chronicConditions      String?
  pastSurgeries          String?
  note                   String?

  patientId  String  @db.Uuid
  tenantId   String  @db.Uuid
  encounterId String? @db.Uuid
  recordedBy String? @db.Uuid

  Patient  Patient @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction, map: "patientMedicalData_patient_tenant_fkey")
  Tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "patientMedicalData_tenantId_fkey")
  Recorder User?   @relation("PatientMedicalDataRecorder", fields: [recordedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "patientMedicalData_recordedBy_fkey")
  Encounter Encounter? @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, patientId, recordedAt], map: "patientMedicalData_tenant_patient_recordedAt_idx")
  @@index([patientId, recordedAt], map: "patientMedicalData_patient_recordedAt_idx")
  @@index([recordedBy], map: "patientMedicalData_recordedBy_idx")
  @@index([encounterId, tenantId])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  name        String
  permissions Json     @default("[]") // Fallback to array JSON structure

  tenantId    String   @db.Uuid
  Tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_tenantId_fkey")
  User        User[]

  @@unique([tenantId, name], map: "role_tenant_name_key_efdfefee")
  @@index([tenantId], map: "Role_tenantId_idx_c93ed4f1")
}

model Room {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  name      String

  wardId    String   @db.Uuid
  tenantId  String   @db.Uuid

  Ward      Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "room_wardId_fkey")
  Tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "room_tenantId_fkey")
  Bed       Bed[]

  @@unique([wardId, name])
  @@index([tenantId], map: "Room_tenantId_idx_c93ed4f1")
  @@index([wardId], map: "Room_wardId_idx_6180a90a")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  tokenHash String    @unique
  ipAddress String?
  userAgent String?

  userId    String    @db.Uuid
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "session_userId_fkey")

  @@index([expiresAt], map: "Session_expiresAt_idx_6b6b8c10")
  @@index([revokedAt], map: "Session_revokedAt_idx_f1d8e6b3")
  @@index([userId], map: "Session_userId_idx_a489d58a")
}

model StaffProfile {
  id                String              @id @default(uuid()) @db.Uuid
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  isActive          Boolean             @default(true)
  employeeId        String
  designation       String?
  description       String?
  phone             String?
  joiningDate       DateTime?           @db.Timestamptz(6)

  userId            String              @unique @db.Uuid
  tenantId          String              @db.Uuid
  departmentId      String?             @db.Uuid
  wardId            String?             @db.Uuid

  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "staffProfile_userId_fkey")
  Tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "staffProfile_tenantId_fkey")
  Department        Department?         @relation(fields: [departmentId], references: [id], onUpdate: NoAction, map: "staffProfile_departmentId_fkey")
  Ward              Ward?               @relation(fields: [wardId], references: [id], onUpdate: NoAction, map: "staffProfile_wardId_fkey")
  StaffAvailability StaffAvailability[]

  @@unique([tenantId, employeeId], map: "staffProfile_tenant_employeeId_key_c90418e2")
  @@unique([id, tenantId], map: "staffProfile_id_tenantId_key")
  @@index([departmentId], map: "StaffProfile_departmentId_idx_8e261ed8")
  @@index([tenantId], map: "StaffProfile_tenantId_idx_c93ed4f1")
  @@index([wardId], map: "StaffProfile_wardId_idx_6180a90a")
}

model StaffAvailability {
  id          String       @id @default(uuid()) @db.Uuid
  dayOfWeek   Int     // 0 = Sunday ... 6 = Saturday
  startMinute Int     // Minutes after midnight
  endMinute   Int     // Exclusive end, at most 1440
  isActive    Boolean      @default(true)

  staffId     String       @db.Uuid
  tenantId    String       @db.Uuid

  StaffProfile StaffProfile @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction, map: "staffAvailability_staffId_fkey")
  Tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "staffAvailability_tenantId_fkey")

  @@index([tenantId, staffId, dayOfWeek, isActive], map: "staffAvailability_schedule_idx")
  @@index([staffId], map: "staffAvailability_staffId_idx")
}

model Tenant {
  id                 String               @id @default(uuid()) @db.Uuid
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  isActive           Boolean              @default(true)
  name               String
  slug               String               @unique
  address            String?
  city               String?
  state              String?
  country            String               @default("PK")
  postalCode         String?
  favicon            String
  logo               String

  Appointment        Appointment[]
  AuditLog           AuditLog[]
  Bed                Bed[]
  Department         Department[]
  DoctorProfile      DoctorProfile[]
  DoctorAvailability DoctorAvailability[]
  Patient            Patient[]
  PatientMedicalData PatientMedicalData[]
  Role               Role[]
  Room               Room[]
  StaffProfile       StaffProfile[]
  StaffAvailability  StaffAvailability[]
  User               User[]
  Ward               Ward[]
  Encounter          Encounter[]
  Consultation       Consultation[]
  Medicine           Medicine[]
  Prescription       Prescription[]
  PrescriptionItem   PrescriptionItem[]
  Admission          Admission[]
  BedAssignment      BedAssignment[]
  OperatingTheatre   OperatingTheatre[]
  SurgeryCase        SurgeryCase[]
  SurgeryTeamMember  SurgeryTeamMember[]
  DischargeSummary   DischargeSummary[]
  StockTransaction   StockTransaction[]
}

model User {
  id                  String         @id @default(uuid()) @db.Uuid
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  isActive            Boolean        @default(true)
  isSuperAdmin        Boolean        @default(false)
  name                String
  email               String         @unique
  passwordHash        String
  authProvider        String?        @default("local")

  roleId              String?        @db.Uuid
  tenantId            String?        @db.Uuid

  Role                Role?          @relation(fields: [roleId], references: [id], onUpdate: NoAction, map: "user_roleId_fkey")
  Tenant              Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_tenantId_fkey")

  // Improved relation names
  CreatedAppointments Appointment[]  @relation("AppointmentCreator")
  UpdatedAppointments Appointment[]  @relation("AppointmentUpdater")
  
  AuditLog            AuditLog[]
  RecordedPatientMedicalData PatientMedicalData[] @relation("PatientMedicalDataRecorder")
  TriagedEncounters Encounter[] @relation("EncounterTriagedBy")
  AssignedBedAssignments BedAssignment[] @relation("BedAssignmentAssignedBy")
  SurgeryTeamMemberships SurgeryTeamMember[]
  RecordedStockTransactions  StockTransaction[]   @relation("StockTransactionRecorder")
  DoctorProfile       DoctorProfile?
  Session             Session[]
  StaffProfile        StaffProfile?

  @@index([roleId], map: "User_roleId_idx_ffccc9a4")
  @@index([tenantId], map: "User_tenantId_idx_c93ed4f1")
}

model Ward {
  id           String         @id @default(uuid()) @db.Uuid
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  name         String

  tenantId     String         @db.Uuid
  departmentId String?        @db.Uuid

  Tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ward_tenantId_fkey")
  Department   Department?    @relation(fields: [departmentId], references: [id], onUpdate: NoAction, map: "ward_departmentId_fkey")
  
  Room         Room[]
  StaffProfile StaffProfile[]

  @@unique([tenantId, name])
  @@index([departmentId], map: "Ward_departmentId_idx_8e261ed8")
  @@index([tenantId], map: "Ward_tenantId_idx_c93ed4f1")
}

model Encounter {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  type           String    @default("outpatient") // outpatient | inpatient | emergency
  source         String    @default("appointment") // appointment | walk_in | emergency | referral
  status         String    @default("waiting") // waiting | in_progress | closed
  disposition    String? // how it ended: discharged_home | admitted | transferred | referred_out | left_without_being_seen | deceased
  chiefComplaint String?
  startedAt      DateTime  @default(now()) @db.Timestamptz(6)
  endedAt        DateTime? @db.Timestamptz(6)
  version        Int       @default(1)

  // Waiting-room token. Resets every day, separately per department.
  queueDate   DateTime? @db.Date
  queueNumber Int?

  // Emergency fields (empty for normal visits)
  triageLevel String? // critical | urgent | normal
  triagedAt   DateTime? @db.Timestamptz(6)
  triagedBy   String?   @db.Uuid
  arrivalMode String? // walk_in | ambulance | referral

  tenantId      String  @db.Uuid
  patientId     String  @db.Uuid
  departmentId  String  @db.Uuid
  doctorId      String? @db.Uuid // can be empty at arrival, e.g. in emergency
  appointmentId String? @unique @db.Uuid // empty for walk-ins and emergencies

  Tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Patient       Patient        @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  Department    Department     @relation(fields: [departmentId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  DoctorProfile DoctorProfile? @relation(fields: [doctorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  Appointment   Appointment?   @relation(fields: [appointmentId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  TriagedByUser User?          @relation("EncounterTriagedBy", fields: [triagedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  Consultation       Consultation[]
  Prescription       Prescription[]
  Admission          Admission?
  BedAssignment      BedAssignment[]
  SurgeryCase        SurgeryCase[]
  PatientMedicalData PatientMedicalData[]

  @@unique([id, tenantId])
  @@unique([appointmentId, tenantId])
  @@unique([tenantId, departmentId, queueDate, queueNumber])
  @@index([tenantId, departmentId, status, startedAt])
  @@index([tenantId, patientId, startedAt])
  @@index([tenantId, status, triageLevel, startedAt])
  @@index([doctorId, status])
}

model Consultation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  kind           String    @default("initial") // initial | ward_round | pre_operative
  chiefComplaint String?
  findings       String?
  diagnosis      String?
  notes          String?
  followUpDate   DateTime? @db.Date

  tenantId    String @db.Uuid
  encounterId String @db.Uuid
  doctorId    String @db.Uuid

  Tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Encounter     Encounter     @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  DoctorProfile DoctorProfile @relation(fields: [doctorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@index([encounterId, createdAt])
  @@index([doctorId, createdAt])
  @@index([tenantId])
}

model Medicine {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  name        String
  genericName String?
  form        String? // tablet | syrup | injection ...
  strength    String? // e.g. 500 mg
  isActive    Boolean  @default(true)

  tenantId String @db.Uuid

  Tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  PrescriptionItem PrescriptionItem[]
  StockTransaction StockTransaction[]

  @@unique([id, tenantId])
  @@index([tenantId, name])
}

model Prescription {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  status    String   @default("active") // active | cancelled
  notes     String? // general advice

  tenantId    String @db.Uuid
  encounterId String @db.Uuid
  doctorId    String @db.Uuid

  Tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Encounter     Encounter     @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  DoctorProfile DoctorProfile @relation(fields: [doctorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  PrescriptionItem PrescriptionItem[]

  @@unique([id, tenantId])
  @@index([encounterId])
  @@index([doctorId, createdAt])
  @@index([tenantId])
}

model PrescriptionItem {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  dose         String // e.g. 500 mg
  frequency    String // e.g. twice daily
  durationDays Int?
  instructions String?
  medicineName String

  tenantId       String @db.Uuid
  prescriptionId String @db.Uuid
  medicineId     String? @db.Uuid

  Tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Prescription Prescription @relation(fields: [prescriptionId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)
  Medicine     Medicine?    @relation(fields: [medicineId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@index([prescriptionId])
  @@index([medicineId])
  @@index([tenantId])
}

model StockTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  type      String
  quantity  Int
  reason    String?

  tenantId   String  @db.Uuid
  medicineId String  @db.Uuid
  recordedBy String? @db.Uuid

  Tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Medicine Medicine @relation(fields: [medicineId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  User     User?    @relation("StockTransactionRecorder", fields: [recordedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([medicineId, createdAt])
  @@index([tenantId])
}

model Admission {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  status             String    @default("admitted") // admitted | discharged
  reason             String
  admissionDiagnosis String?
  admittedAt         DateTime  @default(now()) @db.Timestamptz(6)
  dischargedAt       DateTime? @db.Timestamptz(6)
  dischargeType      String? // routine | against_medical_advice | transferred | deceased
  version            Int       @default(1)

  tenantId          String @db.Uuid
  encounterId       String @db.Uuid
  admittingDoctorId String @db.Uuid
  departmentId      String @db.Uuid

  Tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Encounter      Encounter     @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  AdmittingDoctor DoctorProfile @relation(fields: [admittingDoctorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  Department     Department    @relation(fields: [departmentId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  BedAssignment    BedAssignment[]
  SurgeryCase      SurgeryCase[]
  DischargeSummary DischargeSummary?

  @@unique([id, tenantId])
  @@unique([encounterId, tenantId])
  @@index([tenantId, status, admittedAt])
  @@index([departmentId])
  @@index([admittingDoctorId])
}

model BedAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  assignedAt DateTime  @default(now()) @db.Timestamptz(6)
  releasedAt DateTime? @db.Timestamptz(6)
  reason     String? // admission | transfer | emergency ...

  tenantId    String  @db.Uuid
  bedId       String  @db.Uuid
  encounterId String  @db.Uuid
  admissionId String? @db.Uuid
  assignedBy  String? @db.Uuid

  Tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Bed            Bed        @relation(fields: [bedId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  Encounter      Encounter  @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  Admission      Admission? @relation(fields: [admissionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  AssignedByUser User?      @relation("BedAssignmentAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([bedId, releasedAt])
  @@index([encounterId, releasedAt])
  @@index([admissionId])
  @@index([tenantId])
}

model OperatingTheatre {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  name      String
  isActive  Boolean  @default(true)

  tenantId String @db.Uuid

  Tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  SurgeryCase SurgeryCase[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
}

model SurgeryCase {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  procedureName   String
  status          String    @default("scheduled") // scheduled | in_progress | completed | cancelled | postponed
  scheduledAt     DateTime  @db.Timestamptz(6)
  durationMinutes Int       @default(60)
  startedAt       DateTime? @db.Timestamptz(6)
  endedAt         DateTime? @db.Timestamptz(6)
  anesthesiaType  String? // general | regional | local | sedation
  preOpNotes      String?
  outcomeNotes    String?
  version         Int       @default(1)

  tenantId    String  @db.Uuid
  encounterId String  @db.Uuid
  admissionId String? @db.Uuid // empty for day surgery
  theatreId   String  @db.Uuid
  surgeonId   String  @db.Uuid

  Tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Encounter        Encounter        @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  Admission     Admission?       @relation(fields: [admissionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  OperatingTheatre OperatingTheatre @relation(fields: [theatreId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  Surgeon          DoctorProfile    @relation(fields: [surgeonId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  SurgeryTeamMember SurgeryTeamMember[]

  @@unique([id, tenantId])
  @@index([tenantId, scheduledAt])
  @@index([theatreId, scheduledAt])
  @@index([surgeonId, scheduledAt])
  @@index([encounterId])
}

model SurgeryTeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  role      String // assistant_surgeon | anesthetist | scrub_nurse | circulating_nurse

  tenantId  String @db.Uuid
  surgeryId String @db.Uuid
  userId    String @db.Uuid

  Tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  SurgeryCase SurgeryCase @relation(fields: [surgeryId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)
  User        User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([surgeryId, userId])
  @@index([userId])
  @@index([tenantId])
}

model DischargeSummary {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  finalDiagnosis       String?
  proceduresPerformed  String?
  courseInHospital     String?
  conditionAtDischarge String?
  followUpInstructions String?
  followUpDate         DateTime? @db.Date

  tenantId    String @db.Uuid
  admissionId String @db.Uuid
  doctorId    String @db.Uuid

  Tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Admission     Admission     @relation(fields: [admissionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  DoctorProfile DoctorProfile @relation(fields: [doctorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([admissionId, tenantId])
  @@index([doctorId])
  @@index([tenantId])
}