model Pharmacy {
  id               String   @id @default(uuid()) @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  name             String // e.g., "Main Pharmacy", "ER Pharmacy", "ICU Cabinet"
  type             String   @default("sub_store") // central_store | sub_store
  isActive         Boolean  @default(true)
  pharmacistUserId String?  @unique @db.Uuid

  tenantId         String             @db.Uuid
  Tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  OutgoingRequests StockRequest[]     @relation("OutgoingRequests")
  IncomingRequests StockRequest[]     @relation("IncomingRequests")
  Stocks           PharmacyStock[]
  Transactions     StockTransaction[]
  Pharmacist       User?              @relation("PharmacyPharmacist", fields: [pharmacistUserId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  Sales            Sale[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@unique([pharmacistUserId, tenantId])
  @@index([tenantId, type, isActive])
}

model PharmacyStock {
  id           String @id @default(uuid()) @db.Uuid
  currentStock Int    @default(0)
  reorderLevel Int    @default(10) // Tell the ER to request more from Main when low

  pharmacyId String @db.Uuid
  medicineId String @db.Uuid
  tenantId   String @db.Uuid

  Pharmacy Pharmacy @relation(fields: [pharmacyId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)
  Medicine Medicine @relation(fields: [medicineId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)
  Tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Ensures a pharmacy doesn't have two separate rows for Panadol
  @@unique([pharmacyId, medicineId, tenantId])
  // OPT: added for "which pharmacies have this medicine?" and for deleting a medicine safely (was unindexed)
  @@index([tenantId, medicineId])
}

model StockRequest {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  status      String  @default("pending") // pending | approved | rejected | dispatched | received | partially_received | not_received
  notes       String?
  receiptNote String?

  // NEW: Tracking the exact timeline
  dispatchedAt DateTime? @db.Timestamptz(6)
  receivedAt   DateTime? @db.Timestamptz(6)

  tenantId             String @db.Uuid
  requestingPharmacyId String @db.Uuid
  fulfillingPharmacyId String @db.Uuid

  requestedBy String  @db.Uuid // ER Pharmacist who asked
  handledBy   String? @db.Uuid // Head Pharmacist who approved/dispatched
  receivedBy  String? @db.Uuid // ER Pharmacist who physically opened the box

  Tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  RequestingPharmacy Pharmacy @relation("OutgoingRequests", fields: [requestingPharmacyId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  FulfillingPharmacy Pharmacy @relation("IncomingRequests", fields: [fulfillingPharmacyId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  Requester User  @relation("StockRequester", fields: [requestedBy, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  Handler   User? @relation("StockRequestHandler", fields: [handledBy, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  Receiver  User? @relation("StockRequestReceiver", fields: [receivedBy, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  Items StockRequestItem[]

  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt])
  // OPT: added so each pharmacy can quickly see its own sent / incoming requests
  @@index([requestingPharmacyId, status, createdAt])
  @@index([fulfillingPharmacyId, status, createdAt])
}

model StockRequestItem {
  id String @id @default(uuid()) @db.Uuid

  requestedQuantity Int
  approvedQuantity  Int? // Head pharmacist can approve less than requested
  receivedQuantity  Int?

  tenantId       String @db.Uuid
