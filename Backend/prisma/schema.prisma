// Every change from the original is marked with a "// OPT:" comment.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Appointment {
  id              String   @id @default(uuid()) @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  scheduledAt     DateTime @db.Timestamptz(6)
  endsAt          DateTime @db.Timestamptz(6)
  durationMinutes Int      @default(30)
  status          String   @default("booked")
  notes           String?
  version         Int      @default(1)

  // Foreign Keys
  tenantId     String  @db.Uuid
  departmentId String  @db.Uuid
  doctorId     String  @db.Uuid
  patientId    String  @db.Uuid
  createdBy    String? @db.Uuid
  updatedBy    String? @db.Uuid

  // Relations
  Tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "appointment_tenantId_fkey")
  // OPT: department/doctor/patient now include tenantId, so an appointment can never point to another tenant's data
  Department     Department               @relation(fields: [departmentId, tenantId], references: [id, tenantId], onUpdate: NoAction, map: "appointment_departmentId_fkey")
  DoctorProfile  DoctorProfile            @relation(fields: [doctorId, tenantId], references: [id, tenantId], onUpdate: NoAction, map: "appointment_doctorId_fkey")
  Patient        Patient                  @relation(fields: [patientId, tenantId], references: [id, tenantId], onUpdate: NoAction, map: "appointment_patientId_fkey")
  Creator        User?                    @relation("AppointmentCreator", fields: [createdBy, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "appointment_createdBy_fkey")
  Updater        User?                    @relation("AppointmentUpdater", fields: [updatedBy, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "appointment_updatedBy_fkey")
  Encounter      Encounter?
  BillingInvoice BillingInvoice?
  PublicAccess   PublicAppointmentAccess?

  @@unique([id, tenantId])
  @@index([createdBy], map: "Appointment_createdBy_idx_ba0f792f")
  @@index([departmentId], map: "Appointment_departmentId_idx_8e261ed8")
  @@index([patientId], map: "Appointment_patientId_idx_e5f07e88")
  @@index([tenantId, scheduledAt], map: "Appointment_tenantId_scheduledAt_idx_31e2839e")
  @@index([updatedBy], map: "Appointment_updatedBy_idx_0780dcde")
  @@index([doctorId, scheduledAt], map: "appointment_doctor_schedule_idx_23b246b0")
  // OPT: removed [tenantId] (covered by [tenantId, scheduledAt]) and [doctorId] (covered by [doctorId, scheduledAt])
  // OPT: added for "today's booked appointments" style screens
  @@index([tenantId, status, scheduledAt])
}

model PublicAppointmentAccess {
  id              String   @id @default(uuid()) @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  appointmentId   String   @db.Uuid
  tenantId        String   @db.Uuid
  bookingCodeHash String   @unique
  contactEmail    String
  expiresAt       DateTime @db.Timestamptz(6)

  Appointment Appointment @relation(fields: [appointmentId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([appointmentId, tenantId])
  @@index([tenantId, expiresAt])
  @@map("PublicAppointmentAccess")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  action     String
  entityType String
  entityId   String?  @db.Uuid
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?

  tenantId String? @db.Uuid
  userId   String? @db.Uuid

  Tenant Tenant? @relation(fields: [tenantId], references: [id], onUpdate: NoAction, map: "auditLog_tenantId_fkey")
  User   User?   @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "auditLog_userId_fkey")

  @@index([entityType, entityId], map: "AuditLog_entityType_entityId_idx_ea0fa809")
  @@index([tenantId, createdAt], map: "AuditLog_tenantId_createdAt_idx_88162366")
  // OPT: removed [tenantId] (covered by [tenantId, createdAt]). This table grows fastest, so fewer indexes = faster writes
  @@index([userId], map: "AuditLog_userId_idx_a489d58a")
}

model Bed {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  code      String
  isActive  Boolean  @default(true)
  status    String   @default("available")
  version   Int      @default(1)

  roomId           String  @db.Uuid
  tenantId         String  @db.Uuid
  currentPatientId String? @db.Uuid

  Room          Room            @relation(fields: [roomId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "bed_roomId_fkey")
  Tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bed_tenantId_fkey")
  Patient       Patient?        @relation(fields: [currentPatientId, tenantId], references: [id, tenantId], onUpdate: NoAction, map: "bed_currentPatientId_fkey")
  BedAssignment BedAssignment[]
  BillingRate   BillingRate?

  @@unique([roomId, code], map: "bed_room_code_key_aff24a4e")
  @@unique([id, tenantId])
  @@index([currentPatientId], map: "Bed_currentPatientId_idx_41689716")
  // OPT: removed [roomId] (covered by unique [roomId, code])
  // OPT: added to quickly find available beds
  @@index([tenantId, status])
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  name      String
  isActive  Boolean  @default(true)

  tenantId String @db.Uuid
  Tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "department_tenantId_fkey")

  Appointment   Appointment[]
  Encounter     Encounter[]
  Admission     Admission[]
  DoctorProfile DoctorProfile[]
  StaffProfile  StaffProfile[]
  Ward          Ward[]
  // OPT: removed [tenantId] (covered by unique [tenantId, name])

  @@unique([tenantId, name], map: "department_tenant_name_key_efdfefee")
  @@unique([id, tenantId])
}

model DoctorProfile {
  id             String   @id @default(uuid()) @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  isActive       Boolean  @default(true)
  employeeId     String
  designation    String?
  specialization String
  qualifications String?
  licenseNumber  String?
  description    String?
  phone          String // OPT: no longer globally unique, now unique per hospital (see @@unique below)

  userId       String @unique @db.Uuid
  tenantId     String @db.Uuid
  departmentId String @db.Uuid

  User       User       @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "doctorProfile_userId_fkey")
  Tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "doctorProfile_tenantId_fkey")
  // OPT: department link now includes tenantId (same-tenant guarantee)
  Department Department @relation(fields: [departmentId, tenantId], references: [id, tenantId], onUpdate: NoAction, map: "doctorProfile_departmentId_fkey")

  Appointment        Appointment[]
  Encounter          Encounter[]
  Consultation       Consultation[]
  Prescriptions      Prescription[]
  Admissions         Admission[]
  Surgeries          SurgeryCase[]
  DischargeSummaries DischargeSummary[]
  DoctorAvailability DoctorAvailability[]
  BillingRate        BillingRate[]
  // OPT: removed [tenantId]; both composite unique indexes above start with tenantId

  @@unique([id, tenantId], map: "doctorProfile_id_tenantId_key")
  // OPT: phone and employeeId are unique inside one hospital, not across the whole system
  @@unique([tenantId, phone])
  @@unique([tenantId, employeeId])
  @@unique([userId, tenantId])
  @@index([departmentId], map: "DoctorProfile_departmentId_idx_8e261ed8")
}

model DoctorAvailability {
  id          String  @id @default(uuid()) @db.Uuid
  dayOfWeek   Int // 0 = Sunday ... 6 = Saturday
  startMinute Int // Minutes after midnight
  endMinute   Int // Exclusive end, at most 1440
  isActive    Boolean @default(true)

  doctorId String @db.Uuid
  tenantId String @db.Uuid

  DoctorProfile DoctorProfile @relation(fields: [doctorId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction, map: "doctorAvailability_doctorId_fkey")
  Tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "doctorAvailability_tenantId_fkey")

  @@index([tenantId, doctorId, dayOfWeek, isActive], map: "doctorAvailability_schedule_idx")
  @@index([doctorId], map: "doctorAvailability_doctorId_idx")
}

model Patient {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  isActive  Boolean   @default(true)

  mrn                   String
  firstName             String
  lastName              String
  dob                   DateTime @db.Date // OPT: was Timestamptz; a birth date has no time, and time zones could shift it by a day
  gender                String?
  address               String?
  contactEmail          String?
  contactPhone          String?
  emergencyContactName  String?
  emergencyContactPhone String?
  insuranceProvider     String?
  insurancePolicyNumber String?
  type                  String   @default("Unknown")

  tenantId String @db.Uuid
  Tenant   Tenant @relation(fields: [tenantId], references: [id], onUpdate: NoAction, map: "patient_tenantId_fkey")

  Appointment    Appointment[]
  Encounter      Encounter[]
  Bed            Bed[]
  MedicalData    PatientMedicalData[]
  Sale           Sale[]
  BillingInvoice BillingInvoice[]

  @@unique([tenantId, mrn], map: "patient_tenant_mrn_key_0c21d836")
  @@unique([id, tenantId], map: "patient_id_tenantId_key")
  // OPT: removed [tenantId] (covered by tenantId+MRN and tenantId+lastName indexes)
  @@index([tenantId, lastName], map: "Patient_tenantId_lastName_idx_8d5f431c")
}

model PatientMedicalData {
  id                     String   @id @default(uuid()) @db.Uuid
  recordedAt             DateTime @default(now()) @db.Timestamptz(6)
  heartRate              Int?
  totalCholesterol       Int?
  hemoglobin             Float?
  systolicBloodPressure  Int?
  diastolicBloodPressure Int?
  bloodGlucose           Int?
  whiteBloodCellCount    Int?
  bodyMassIndex          Float?
  respiratoryRate        Int?
  plateletCount          Int?
  allergies              String?
  chronicConditions      String?
  pastSurgeries          String?
  note                   String?

  patientId   String  @db.Uuid
  tenantId    String  @db.Uuid
  encounterId String? @db.Uuid
  recordedBy  String? @db.Uuid

  Patient   Patient    @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "patientMedicalData_patient_tenant_fkey")
  Tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "patientMedicalData_tenantId_fkey")
  Recorder  User?      @relation("PatientMedicalDataRecorder", fields: [recordedBy, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "patientMedicalData_recordedBy_fkey")
  Encounter Encounter? @relation(fields: [encounterId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, patientId, recordedAt], map: "patientMedicalData_tenant_patient_recordedAt_idx")
  // OPT: removed [patientId, recordedAt]; the tenant version above does the same job. This table gets many inserts, so one less index helps
  @@index([recordedBy], map: "patientMedicalData_recordedBy_idx")
  @@index([encounterId, tenantId])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  name        String
  permissions Json     @default("[]") // Fallback to array JSON structure

  tenantId String @db.Uuid
  Tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_tenantId_fkey")
  User     User[]
  // OPT: removed [tenantId] (covered by unique [tenantId, name])

  @@unique([tenantId, name], map: "role_tenant_name_key_efdfefee")
  @@unique([id, tenantId], map: "role_id_tenantId_key")
}

model Room {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  name      String
  isActive  Boolean  @default(true)

  wardId   String @db.Uuid
  tenantId String @db.Uuid

  Ward   Ward   @relation(fields: [wardId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "room_wardId_fkey")
  Tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "room_tenantId_fkey")
  Bed    Bed[]
  // OPT: removed [wardId] (covered by unique [wardId, name])

  @@unique([wardId, name])
  @@unique([id, tenantId], map: "room_id_tenantId_key")
  @@index([tenantId], map: "Room_tenantId_idx_c93ed4f1")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  tokenHash String    @unique
  ipAddress String?
  userAgent String?

  userId String @db.Uuid
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "session_userId_fkey")

  @@index([expiresAt], map: "Session_expiresAt_idx_6b6b8c10")
  // OPT: removed [revokedAt]; it is NULL for most rows so the index almost never helps, but costs a write on every login/logout
  @@index([userId], map: "Session_userId_idx_a489d58a")
}

model StaffProfile {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  isActive    Boolean   @default(true)
  name        String
  email       String?
  employeeId  String
  designation String?
  description String?
  phone       String?
  joiningDate DateTime? @db.Timestamptz(6)

  userId       String? @unique @db.Uuid
  tenantId     String  @db.Uuid
  departmentId String? @db.Uuid
  wardId       String? @db.Uuid

  User              User?               @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "staffProfile_userId_fkey")
  Tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "staffProfile_tenantId_fkey")
  // OPT: department link now includes tenantId (same-tenant guarantee)
  Department        Department?         @relation(fields: [departmentId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "staffProfile_departmentId_fkey")
  Ward              Ward?               @relation(fields: [wardId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "staffProfile_wardId_fkey")
  StaffAvailability StaffAvailability[]

  @@unique([tenantId, employeeId], map: "staffProfile_tenant_employeeId_key_c90418e2")
  @@unique([userId, tenantId], map: "staffProfile_userId_tenantId_key")
  @@unique([id, tenantId], map: "staffProfile_id_tenantId_key")
  @@index([departmentId], map: "StaffProfile_departmentId_idx_8e261ed8")
  // OPT: removed [tenantId] (covered by unique [tenantId, employeeId])
  @@index([wardId], map: "StaffProfile_wardId_idx_6180a90a")
}

model StaffAvailability {
  id          String  @id @default(uuid()) @db.Uuid
  dayOfWeek   Int // 0 = Sunday ... 6 = Saturday
  startMinute Int // Minutes after midnight
  endMinute   Int // Exclusive end, at most 1440
  isActive    Boolean @default(true)

  staffId  String @db.Uuid
  tenantId String @db.Uuid

  StaffProfile StaffProfile @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction, map: "staffAvailability_staffId_fkey")
  Tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "staffAvailability_tenantId_fkey")

  @@index([tenantId, staffId, dayOfWeek, isActive], map: "staffAvailability_schedule_idx")
  @@index([staffId], map: "staffAvailability_staffId_idx")
}

model Tenant {
  id                 String    @id @default(uuid()) @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  isActive           Boolean   @default(true)
  name               String
  slug               String    @unique
  address            String?
  city               String?
  state              String?
  country            String    @default("PK")
  postalCode         String?
  favicon            String
  logo               String
  approvalStatus     String    @default("approved")
  approvalNote       String?
  approvalReviewedAt DateTime? @db.Timestamptz(6)

  Appointment          Appointment[]
  AuditLog             AuditLog[]
  Bed                  Bed[]
  Department           Department[]
  DoctorProfile        DoctorProfile[]
  DoctorAvailability   DoctorAvailability[]
  Patient              Patient[]
  PatientMedicalData   PatientMedicalData[]
  Role                 Role[]
  Room                 Room[]
  StaffProfile         StaffProfile[]
  StaffAvailability    StaffAvailability[]
  User                 User[]
  Ward                 Ward[]
  Encounter            Encounter[]
  Consultation         Consultation[]
  Medicine             Medicine[]
  Prescription         Prescription[]
  PrescriptionItem     PrescriptionItem[]
  Admission            Admission[]
  BedAssignment        BedAssignment[]
  OperatingTheatre     OperatingTheatre[]
  SurgeryCase          SurgeryCase[]
  SurgeryTeamMember    SurgeryTeamMember[]
  DischargeSummary     DischargeSummary[]
  StockTransaction     StockTransaction[]
  Pharmacy             Pharmacy[]
  PharmacyStock        PharmacyStock[]
  StockRequest         StockRequest[]
  StockRequestItem     StockRequestItem[]
  Sale                 Sale[]
  SaleItem             SaleItem[]
  BillingRate          BillingRate[]
  BillingInvoice       BillingInvoice[]
  BillingPayment       BillingPayment[]
  billingInvoiceItems  BillingInvoiceItem[]
  TenantCounter        TenantCounter[]
  PlatformSubscription PlatformSubscription?
}

model PlatformSubscription {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @unique @db.Uuid
  plan                 String
  status               String    @default("incomplete")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime? @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)

  Tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("PlatformSubscription")
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("StripeWebhookEvent")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  isActive     Boolean  @default(true)
  isSuperAdmin Boolean  @default(false)
  name         String
  email        String   @unique
  passwordHash String
  authProvider String?  @default("local")

  roleId   String? @db.Uuid
  tenantId String? @db.Uuid

  Role   Role?   @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "user_roleId_fkey")
  Tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_tenantId_fkey")

  // Improved relation names
  CreatedAppointments Appointment[] @relation("AppointmentCreator")
  UpdatedAppointments Appointment[] @relation("AppointmentUpdater")

  AuditLog                   AuditLog[]
  RecordedPatientMedicalData PatientMedicalData[] @relation("PatientMedicalDataRecorder")
  TriagedEncounters          Encounter[]          @relation("EncounterTriagedBy")
  AssignedBedAssignments     BedAssignment[]      @relation("BedAssignmentAssignedBy")
  SurgeryTeamMemberships     SurgeryTeamMember[]
  RecordedStockTransactions  StockTransaction[]   @relation("StockTransactionRecorder")
  DoctorProfile              DoctorProfile?
  Session                    Session[]
  StaffProfile               StaffProfile?
  CreatedStockRequests       StockRequest[]       @relation("StockRequester")
  HandledStockRequests       StockRequest[]       @relation("StockRequestHandler")
  ReceivedStockRequests      StockRequest[]       @relation("StockRequestReceiver")
  CollectedPayments          BillingPayment[]     @relation("PaymentCollector")
  CreatedBillingInvoices     BillingInvoice[]     @relation("BillingInvoiceCreator")
  ManagedPharmacy            Pharmacy?            @relation("PharmacyPharmacist")
  PharmacySales              Sale[]               @relation("SaleSeller")

  @@unique([id, tenantId], map: "user_id_tenantId_key")
  @@index([roleId], map: "User_roleId_idx_ffccc9a4")
  @@index([tenantId], map: "User_tenantId_idx_c93ed4f1")
}

model Ward {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  name      String
  isActive  Boolean  @default(true)

  tenantId     String  @db.Uuid
  departmentId String? @db.Uuid

  Tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ward_tenantId_fkey")
  // OPT: department link now includes tenantId (same-tenant guarantee)
  Department Department? @relation(fields: [departmentId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "ward_departmentId_fkey")

  Room         Room[]
  StaffProfile StaffProfile[]
  // OPT: removed [tenantId] (covered by unique [tenantId, name])

  @@unique([tenantId, name])
  @@unique([id, tenantId], map: "ward_id_tenantId_key")
  @@index([departmentId], map: "Ward_departmentId_idx_8e261ed8")
}

model Encounter {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  type           String    @default("outpatient") // outpatient | inpatient | emergency
  source         String    @default("appointment") // appointment | walk_in | emergency | referral
  status         String    @default("waiting") // waiting | in_progress | closed
  disposition    String? // how it ended: discharged_home | admitted | transferred | referred_out | left_without_being_seen | deceased
  chiefComplaint String?
  startedAt      DateTime  @default(now()) @db.Timestamptz(6)
  endedAt        DateTime? @db.Timestamptz(6)
  version        Int       @default(1)

  // Waiting-room token. Resets every day, separately per department.
  queueDate   DateTime? @db.Date
  queueNumber Int?

  // Emergency fields (empty for normal visits)
  triageLevel String? // critical | urgent | normal
  triagedAt   DateTime? @db.Timestamptz(6)
  triagedBy   String?   @db.Uuid
  arrivalMode String? // walk_in | ambulance | referral

  tenantId      String  @db.Uuid
  patientId     String  @db.Uuid
  departmentId  String  @db.Uuid
  doctorId      String? @db.Uuid // can be empty at arrival, e.g. in emergency
  appointmentId String? @unique @db.Uuid // empty for walk-ins and emergencies

  Tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Patient       Patient        @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  Department    Department     @relation(fields: [departmentId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
