  Invoice   BillingInvoice @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  Collector User           @relation("PaymentCollector", fields: [collectedBy, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, createdAt])
  @@index([invoiceId, createdAt])
}

model TenantCounter {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  kind      String
  nextValue Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  Tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, kind])
  @@index([tenantId])
}
